# Ключ с https://proxyapi.ru (или OpenAI)
OPENAI_API_KEY=

# ProxyAPI OpenAI — vision / design дневников
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Чат Маи — DeepSeek через OpenRouter (тот же ключ ProxyAPI)
# OPENAI_CHAT_BASE_URL=https://api.proxyapi.ru/openrouter/v1
OPENAI_CHAT_MODEL=deepseek/deepseek-chat-v3.1

# Очередь чата (общая на все pm2 через SQLite)
# CHAT_MAX_CONCURRENT=50
# CHAT_MAX_WAITING=120
# CHAT_QUEUE_WAIT_MS=40000
# CHAT_PM2_INSTANCES=2

# Фото одежды / анализы — GPT
OPENAI_VISION_MODEL=gpt-4.1-mini
# Создание дневников
OPENAI_DESIGN_MODEL=gpt-4.1

# Публичный адрес сайта
NEXT_PUBLIC_SITE_URL=https://hey-maya.ru

# Реквизиты ИП (по умолчанию — те же, что на lollypollya.ru)
# NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Индивидуальный предприниматель Ковалева Полина Андреевна
# NEXT_PUBLIC_LEGAL_OPERATOR_SHORT=ИП Ковалева Полина Андреевна
# NEXT_PUBLIC_LEGAL_INN=344107729380
# NEXT_PUBLIC_LEGAL_OGRNIP=325344300155000
# NEXT_PUBLIC_LEGAL_ADDRESS=400120, Волгоградская обл., г. Волгоград, ул. Елецкая, 91, Российская Федерация
# NEXT_PUBLIC_LEGAL_EMAIL=pollilollipop@yandex.ru
# NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=levprogrammist@gmail.com

# Resend — письма с кодом регистрации https://resend.com/api-keys
RESEND_API_KEY=
# Для теста можно оставить пустым → from = onboarding@resend.dev
# После верификации домена: Мая <noreply@ваш-домен.ru>
RESEND_FROM=

# OAuth — вход через Mail.ru БЕЗ кода (кнопка «Войти с Mail.ru»)
# Кабинет: https://oauth.mail.ru/ → приложение
# Redirect URI ровно:
# https://hey-maya.ru/api/auth/oauth/mailru/callback/
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# Пароль страницы аналитики /admin/stats и админки /admin
# По умолчанию: maya-stats
ANALYTICS_PASSWORD=maya-stats
ADMIN_PASSWORD=maya-stats

# SQLite — заказы планов (по умолчанию data/maya.db на сервере)
# DATABASE_PATH=/var/www/maya/data/maya.db

# Тест оффера без ожидания: только на стейдже, не в проде
# PLAN_OFFER_INSTANT=true

# Секрет сессий (обязательно на VPS). Можно тот же, что NEXT_SERVER_ACTIONS:
AUTH_SECRET=DPEZn35NF4GXiXF/tJrPE4tgrGS55JeVCSpLVZ39sWM=

# Push (PWA). Сгенерировать: npx web-push generate-vapid-keys
# Без ключей уведомления всё равно работают, пока приложение открыто / на экране.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:levprogrammist@gmail.com

# Стабильный ключ Server Actions (чтобы после деплоя старые вкладки меньше ломались)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Задать на VPS ПЕРЕД npm run build:
# export NEXT_SERVER_ACTIONS_ENCRYPTION_KEY='....'
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Prodamus — оплата Premium и планов
# Секретный ключ из настроек платёжной формы (НЕ вставлять в URL уведомлений)
PRODAMUS_SECRET_KEY=
# Адрес вашей формы, например https://xxxx.payform.ru
PRODAMUS_PAYFORM_URL=
# Пока нет кассы: заказы планов работают без оплаты (по умолчанию).
# Когда заданы PRODAMUS_* — оплата включается сама. false = требовать кассу.
# PLAN_ORDERS_BYPASS_PAYMENT=false

# Telegram-бот Мая · Малыш (@MayaMalyshBot)
# Токен только здесь / на сервере — НЕ в git и НЕ в чаты
TELEGRAM_BOT_TOKEN=
# Уведомления о заказах планов: напишите боту /notify (с аккаунта @tarabaner)
# или задайте chat_id вручную:
ADMIN_TELEGRAM_USERNAME=tarabaner
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_NOTIFY_EMAIL=levprogrammist@gmail.com
# Секрет для webhook (если когда-нибудь снова понадобится)
TELEGRAM_WEBHOOK_SECRET=
# Ключ для POST /api/telegram/setup
TELEGRAM_SETUP_KEY=
# Опционально: прокси/зеркало API, если хостинг режет api.telegram.org
# TELEGRAM_API_ROOT=https://api.telegram.org
