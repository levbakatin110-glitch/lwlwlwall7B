# Ключ с https://proxyapi.ru (или OpenAI)
OPENAI_API_KEY=

# ProxyAPI — без VPN из РФ
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Чат + фото — одна модель
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# Публичный адрес сайта (для шаринга фильмов)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — письма с кодом регистрации https://resend.com/api-keys
RESEND_API_KEY=
# Для теста можно оставить пустым → from = onboarding@resend.dev
# После верификации домена: Мая <noreply@ваш-домен.ru>
RESEND_FROM=

# OAuth — вход через VK ID и Mail.ru
# Секрет подписи state/ticket (любая длинная случайная строка)
AUTH_SECRET=
# https://id.vk.com/about/business/go → создать приложение (Веб-сайт)
# Redirect URI: https://hey-maya.ru/api/auth/oauth/vk/callback
# Домен: hey-maya.ru + запросить доступ к email
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# https://oauth.mail.ru/ → приложение (или Mail через VK ID)
# Redirect URI: https://hey-maya.ru/api/auth/oauth/mailru/callback
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# Google больше не используется
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Пароль страницы аналитики /admin/stats
ANALYTICS_PASSWORD=maya-stats

# Prodamus — оплата Premium
# Секретный ключ из настроек платёжной формы (НЕ вставлять в URL уведомлений)
PRODAMUS_SECRET_KEY=
# Адрес вашей формы, например https://xxxx.payform.ru
PRODAMUS_PAYFORM_URL=
# Публичный URL сайта (для возврата после оплаты и webhook)
NEXT_PUBLIC_SITE_URL=https://hey-maya.ru

# Telegram-бот Мая · Малыш (@MayaMalyshBot)
# Токен только здесь / на сервере — НЕ в git и НЕ в чаты
TELEGRAM_BOT_TOKEN=
# Секрет для webhook (если когда-нибудь снова понадобится)
TELEGRAM_WEBHOOK_SECRET=
# Ключ для POST /api/telegram/setup
TELEGRAM_SETUP_KEY=
# Опционально: прокси/зеркало API, если хостинг режет api.telegram.org
# TELEGRAM_API_ROOT=https://api.telegram.org
