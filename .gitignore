# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# shared memory films (user-generated)
/data/

# vercel
.vercel

# Android upload key. Do not commit.
/android-signing/

# iOS CocoaPods (ставится на Mac: cd ios/App && pod install)
ios/App/Pods/
ios/DerivedData/

# typescript
*.tsbuildinfo
next-env.d.ts
